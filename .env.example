# Copy to .env.local and fill in. Never commit .env.local.
# Khush shares the real values privately (never over the repo).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only, bypasses RLS. Webhooks + admin console only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Retell AI (voice runtime) ---
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# --- Sarvam AI (voice runtime for Indian-language agents) ---
# There is no webhook secret: Sarvam does not sign its webhooks. The route is
# authenticated by an unguessable per-agent token in the URL path instead, held
# in voice_agents.webhook_token, not here.
#
# These three are only for FETCHING RECORDINGS. Sarvam's post-call payload has
# no audio at all; it comes from a separate analytics endpoint that needs an
# API key plus the org and workspace the agent lives in. Leave them blank and
# calls still ingest fully — transcript, trip brief, lead, minutes — but with
# no playable audio.
#
# Org and workspace ids appear in the Sarvam console URL. Confirm the endpoint
# returns what you expect with: node scripts/probe-sarvam.mjs
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# --- Stripe (billing: base subscription + metered overage) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (invites, notifications, daily digest) ---
RESEND_API_KEY=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
