# Copy to .env.local and fill in. Never commit .env.local.
# Khush shares the real values privately (never over the repo).

# --- App ---
# OPTIONAL on Vercel. Only needed to name a custom domain. Left unset, the app
# derives its own URL from Vercel's VERCEL_PROJECT_PRODUCTION_URL in production
# and VERCEL_URL on a preview (see src/lib/app-url.ts), which is what the admin
# Webhooks page uses to build provider URLs. Set it locally only if you are not
# on port 3000.
NEXT_PUBLIC_APP_URL=

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only, bypasses RLS. Webhooks + admin console only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Retell AI (voice runtime) ---
# Signs incoming webhooks. Without it the Retell route returns 500 and refuses
# every delivery, so this is required if any agent uses Retell.
RETELL_WEBHOOK_SECRET=

# --- Vapi (voice runtime for the US/international agents) ---
# Server-only. Needed ONLY to download call recordings. Vapi's payload carries
# an `artifact.recordingUrl`, but as of the 2026 storage change that points into
# a private bucket and 403s unauthenticated; audio comes from
# GET /call/{id}/stereo-recording with this key as a Bearer token. Leave it
# blank and calls still ingest fully — transcript, trip brief, lead, minutes —
# with no playable audio. There is no webhook secret: the route is
# authenticated by an unguessable per-agent token in the URL path, held in
# voice_agents.webhook_token.
VAPI_API_KEY=

# --- Sarvam AI (voice runtime for Indian-language agents) ---
# There is no webhook secret: Sarvam does not sign its webhooks. The route is
# authenticated by an unguessable per-agent token in the URL path instead, held
# in voice_agents.webhook_token, not here.
#
# These three are only for FETCHING RECORDINGS. Sarvam's post-call payload has
# no audio at all; it comes from a separate analytics endpoint that needs an
# API key plus the org and workspace the agent lives in. Leave them blank and
# calls still ingest fully — transcript, trip brief, lead, minutes — but with
# no playable audio.
#
# Org and workspace ids appear in the Sarvam console URL. Confirm the endpoint
# returns what you expect with: node scripts/probe-sarvam.mjs
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# --- Not currently read by any code ---
# Billing is Dodo Payments, not Stripe (Stripe requires a US entity; the spec
# predates that decision). Dodo, Resend and Sentry are planned but nothing imports them yet. They
# were listed here as blanks, which made a deploy look like it needed eight
# more credentials than it does. Add them back when the code that reads them
# lands, not before.

# Voice Agents platform key — workspace-scoped, minted in the Sarvam console.
# NOT the same as SARVAM_API_KEY above: that one is the sk_ speech key used for
# fetching recordings. This one drives the deployments/campaigns/outbound REST
# API at apps.sarvam.ai/api/app-authoring, and is sent as `x-api-key`
# (Bearer is rejected).
SARVAM_VOICE_API_KEY=
