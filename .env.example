# Copy to .env.local and fill in. Never commit .env.local.
# Khush shares the real values privately (never over the repo).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: server-only, bypasses RLS. Webhooks + admin console only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Retell AI (voice runtime) ---
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=

# --- Stripe (billing: base subscription + metered overage) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (invites, notifications, daily digest) ---
RESEND_API_KEY=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
